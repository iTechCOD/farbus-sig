<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_BPMN_TOBE_operacion" targetNamespace="https://farbus.cl/academico/sig" exporter="Farbus E2">
  <bpmn:process id="Process_BPMN_TOBE_operacion" name="BPMN TOBE operacion" isExecutable="false">
    <bpmn:laneSet id="LaneSet_BPMN_TOBE_operacion">
      <bpmn:lane id="Lane_Administracion_logistica" name="Administracion logistica">
        <bpmn:flowNodeRef>Node_planificar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_ajustar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_comunicar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_registrar</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SIG" name="SIG">
        <bpmn:flowNodeRef>Node_validar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_consolidar</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Conductor" name="Conductor">
        <bpmn:flowNodeRef>Node_ejecutar</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Eventos" name="Eventos">
        <bpmn:flowNodeRef>Node_inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_fin</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Node_inicio" name="Solicitud de traslado" />
    <bpmn:userTask id="Node_planificar" name="Programar vuelta&#10;(logística)" />
    <bpmn:serviceTask id="Node_validar" name="Validar vehículo, licencia&#10;y revisión técnica" />
    <bpmn:exclusiveGateway id="Node_decision" name="¿Habilitado?" />
    <bpmn:userTask id="Node_ajustar" name="Corregir asignación&#10;(logística)" />
    <bpmn:userTask id="Node_comunicar" name="Comunicar hoja de ruta&#10;por WhatsApp" />
    <bpmn:userTask id="Node_ejecutar" name="Ejecutar servicio&#10;y completar papel" />
    <bpmn:userTask id="Node_registrar" name="Registrar vuelta real&#10;en el SIG" />
    <bpmn:serviceTask id="Node_consolidar" name="Actualizar consolidado&#10;y tarifa del periodo" />
    <bpmn:endEvent id="Node_fin" name="Datos listos para&#10;preliquidación" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Node_inicio" targetRef="Node_planificar" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Node_planificar" targetRef="Node_validar" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Node_validar" targetRef="Node_decision" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Node_decision" targetRef="Node_comunicar" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Node_decision" targetRef="Node_ajustar" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Node_ajustar" targetRef="Node_validar" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Node_comunicar" targetRef="Node_ejecutar" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Node_ejecutar" targetRef="Node_registrar" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Node_registrar" targetRef="Node_consolidar" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Node_consolidar" targetRef="Node_fin" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_BPMN_TOBE_operacion">
    <bpmndi:BPMNPlane id="Plane_BPMN_TOBE_operacion" bpmnElement="Process_BPMN_TOBE_operacion">
      <bpmndi:BPMNShape id="Shape_inicio" bpmnElement="Node_inicio">
        <dc:Bounds x="30" y="128" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_planificar" bpmnElement="Node_planificar">
        <dc:Bounds x="110" y="110" width="144" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_validar" bpmnElement="Node_validar">
        <dc:Bounds x="295" y="110" width="144" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_decision" bpmnElement="Node_decision">
        <dc:Bounds x="480" y="120" width="52" height="52" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ajustar" bpmnElement="Node_ajustar">
        <dc:Bounds x="480" y="265" width="144" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_comunicar" bpmnElement="Node_comunicar">
        <dc:Bounds x="580" y="110" width="144" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ejecutar" bpmnElement="Node_ejecutar">
        <dc:Bounds x="765" y="110" width="144" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_registrar" bpmnElement="Node_registrar">
        <dc:Bounds x="950" y="110" width="144" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_consolidar" bpmnElement="Node_consolidar">
        <dc:Bounds x="1135" y="110" width="144" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_fin" bpmnElement="Node_fin">
        <dc:Bounds x="1320" y="128" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_1" bpmnElement="Flow_1">
        <di:waypoint x="66" y="146.0" />
        <di:waypoint x="110" y="146.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_2" bpmnElement="Flow_2">
        <di:waypoint x="254" y="146.0" />
        <di:waypoint x="295" y="146.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_3" bpmnElement="Flow_3">
        <di:waypoint x="439" y="146.0" />
        <di:waypoint x="480" y="146.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_4" bpmnElement="Flow_4">
        <di:waypoint x="532" y="146.0" />
        <di:waypoint x="580" y="146.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_5" bpmnElement="Flow_5">
        <di:waypoint x="532" y="146.0" />
        <di:waypoint x="480" y="301.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_6" bpmnElement="Flow_6">
        <di:waypoint x="552.0" y="337" />
        <di:waypoint x="367.0" y="110" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_7" bpmnElement="Flow_7">
        <di:waypoint x="724" y="146.0" />
        <di:waypoint x="765" y="146.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_8" bpmnElement="Flow_8">
        <di:waypoint x="909" y="146.0" />
        <di:waypoint x="950" y="146.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_9" bpmnElement="Flow_9">
        <di:waypoint x="1094" y="146.0" />
        <di:waypoint x="1135" y="146.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_10" bpmnElement="Flow_10">
        <di:waypoint x="1279" y="146.0" />
        <di:waypoint x="1320" y="146.0" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>