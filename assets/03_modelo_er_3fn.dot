digraph ER { rankdir=LR; graph [bgcolor="white",fontname="DejaVu Sans",pad="0.4",nodesep="0.4",ranksep="1.0",splines=polyline,overlap=false];
node [shape=Mrecord,fontname="DejaVu Sans",fontsize=11,color="#6f94bd",penwidth=1.3,style="filled",fillcolor="#f0f6fc",fontcolor="#1c3852"];
edge [color="#8ca0b6",arrowsize=0.55,penwidth=1.1];
CLIENTE [label="CLIENTE\n----------\nid_cliente PK\nnombre UQ"];
PLANTA [label="PLANTA\n----------\nid_planta PK\nid_cliente FK\nnombre, localidad"];
CONTRATO [label="CONTRATO\n----------\nid_contrato PK\nid_cliente FK\ncódigo, inicio, fin"];
RECORRIDO [label="RECORRIDO\n----------\ncod_recorrido PK\nid_planta FK\nturno, km_estimados"];
TARIFA [label="TARIFA\n----------\nid_tarifa PK\nid_contrato FK\ncod_recorrido FK\nmonto, vigencias"];
CONDUCTOR [label="CONDUCTOR\n----------\nid_conductor PK\ncódigo, clase_licencia\nlicencia_vence, activo"];
VEHICULO [label="VEHICULO\n----------\npatente PK\ntipo, modelo, capacidad\nestado, odometro_actual"];
DOCUMENTO [label="DOCUMENTO\n----------\nid_documento PK\npatente FK\ntipo, vencimiento"];
ESTANQUE [label="ESTANQUE\n----------\nid_estanque PK\ncódigo, capacidad"];
CARGA [label="CARGA\n----------\nid_carga PK\npatente FK, id_estanque FK\nlitros, odómetro, fecha"];
MANTENCION [label="MANTENCION\n----------\nid_mantencion PK\npatente FK\nfecha, odómetro, próximo km"];
PROGRAMACION [label="PROGRAMACION\n----------\nid_programacion PK\nid_contrato, cod_recorrido FK\npatente, id_conductor FK\nfecha, turno, sentido"];
VUELTA [label="VUELTA\n----------\nid_vuelta PK\nid_programacion FK/UQ\npasajeros, horas, vale, estado"];
PRELIQUIDACION [label="PRELIQUIDACION\n----------\nid_preliquidacion PK\nid_contrato FK\nperiodo inicio / fin"];
DETALLE [label="DETALLE\n----------\n(id_preliq, id_vuelta) PK\nid_vuelta UQ\nmonto_clp"];
