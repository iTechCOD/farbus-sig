digraph ER {
  rankdir=LR;
  splines=spline;
  nodesep=0.55;
  ranksep=1.5;
  bgcolor="white";
  node [shape=plaintext, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica"];
  labelloc="t";
  label=<<FONT POINT-SIZE="18"><B>Figura 5 — Modelo entidad-relacion preliminar del TO-BE</B></FONT><BR/>
         <FONT POINT-SIZE="11" COLOR="#52606d">Sociedad de Transportes Farbus Ltda. — subrayado = clave primaria candidata; FK = clave foranea</FONT><BR/> >;
